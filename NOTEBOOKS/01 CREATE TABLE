create table retail_sales (
row_id INTEGER,
order_id VARCHAR(50),
order_date VARCHAR,
ship_date VARCHAR,
ship_mode VARCHAR(50),
customer_id VARCHAR(50),
customer_name VARCHAR(100),
segment VARCHAR(50),
country VARCHAR(100),
city VARCHAR(100),
state VARCHAR(100),
postal_code VARCHAR(20),
region VARCHAR(50),
product_id VARCHAR(50),
category VARCHAR(50),
sub_category VARCHAR(50),
product_name TEXT,
sales TEXT,
quantity TEXT,
discount TEXT,
profit TEXT
);



